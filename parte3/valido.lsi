def fatorial(int n) {
    if (n <= 1) {
        return 1;
    } else {
        int resultado_parcial;
        resultado_parcial = n - 1;
        int proximo_fatorial;
        proximo_fatorial = fatorial(resultado_parcial);
        return n * proximo_fatorial;
    }
}

def max(int a, int b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

